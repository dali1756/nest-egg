HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://admin:change-me@localhost:5433/nest_egg?sslmode=disable
LOG_LEVEL=info
LOG_FORMAT=text
COOKIE_SECURE=false
# 反向代理的 IP 或 CIDR（逗號分隔）。有設定時，來自這些位址的請求才會採用 X-Forwarded-For 判斷使用者 IP；沒有反向代理就留空
TRUSTED_PROXIES=

