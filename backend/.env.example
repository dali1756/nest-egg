HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://admin:change-me@localhost:5433/nest_egg?sslmode=disable
LOG_LEVEL=info
LOG_FORMAT=text
# session cookie 的加密金鑰（必填）。產生方式：openssl rand -hex 32
SESSION_SECRET=
# 本機用 http 開發時設 false；正式環境（https）維持預設 true
COOKIE_SECURE=false
# 整合測試用的資料庫；沒設定時跳過需要資料庫的測試
TEST_DATABASE_URL=postgres://admin:change-me@localhost:5433/nest_egg?sslmode=disable
