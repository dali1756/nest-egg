#!/bin/bash
# 假 curl，給 unit.test.sh 用。只支援 lib.sh 用到的參數。
#   回應：依序取 $FAKE_CURL_RESPONSES 的每一行（格式：狀態碼<TAB>內容），用完後重複最後一行；
#         狀態碼 000 代表連線失敗（像真的 curl 一樣印出 000 並回傳 7）。
#   紀錄：每次呼叫把「方法 URL 資料」append 到 $FAKE_CURL_LOG。
out="" method=GET data="" url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out=$2; shift 2 ;;
    -X) method=$2; shift 2 ;;
    --data) data=$2; shift 2 ;;
    -w | -H | --max-time) shift 2 ;;
    -*) shift ;;
    *) url=$1; shift ;;
  esac
done
echo "${method} ${url} ${data}" >>"$FAKE_CURL_LOG"
calls=$(wc -l <"$FAKE_CURL_LOG" | tr -d ' ')
total=$(wc -l <"$FAKE_CURL_RESPONSES" | tr -d ' ')
[ "$calls" -le "$total" ] || calls=$total
line=$(sed -n "${calls}p" "$FAKE_CURL_RESPONSES")
status=${line%%$'\t'*}
body=${line#*$'\t'}
if [ "$status" = 000 ]; then
  printf '000'
  exit 7
fi
printf '%s\n' "$body" >"$out"
printf '%s' "$status"
